{
  "name": "mtg-magiccon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --configLoader runner",
    "check:ui": "pnpm build",
    "check:ship": "pnpm build && pnpm validate:text && pnpm validate:secrets",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/clean_dist.ps1 && tsc -b && vite build --configLoader runner",
    "build:pages": "pnpm build && powershell -ExecutionPolicy Bypass -File scripts/prepare_github_pages.ps1",
    "verify:public": "powershell -ExecutionPolicy Bypass -File scripts/verify_public_pages.ps1",
    "publish:pages": "pnpm build:pages && pnpm validate:text && pnpm validate:secrets",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "validate:monitoring": "powershell -ExecutionPolicy Bypass -File scripts/validate_monitoring_intake.ps1",
    "validate:text": "powershell -ExecutionPolicy Bypass -File scripts/validate_text_integrity.ps1",
    "validate:secrets": "powershell -ExecutionPolicy Bypass -File scripts/check_secrets.ps1",
    "readiness": "powershell -ExecutionPolicy Bypass -File scripts/environment_readiness.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.55.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4",
    "workbox-window": "7.4.1"
  }
}
